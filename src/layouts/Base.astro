---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {
  ALL_LOCALES,
  CATEGORY_TEXT,
  LAYOUT_TEXT,
  LOCALES,
  bundle,
  localizedPath,
  switchLocalePath,
  type Locale,
} from '../lib/locales';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  canonicalPath?: string;
  alternates?: { lang: string; path: string }[];
}
const {
  title = 'Unfleece — free, private PDF tools',
  description = 'Free, private PDF tools that run 100% in your browser. Merge, split, compress, convert and sign — no file upload, no account, no fleeceware.',
  lang = 'en',
  canonicalPath,
  alternates = [],
} = Astro.props;

const fullTitle = title === 'Unfleece — free, private PDF tools' ? title : `${title} · Unfleece`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString();
const repo = 'https://github.com/darekhta/Unfleece';

// Open Graph locale codes (locale_TERRITORY) for each supported language.
const OG_LOCALE: Record<Locale, string> = {
  en: 'en_US', zh: 'zh_CN', hi: 'hi_IN', es: 'es_ES', fr: 'fr_FR', ar: 'ar_AR',
  pt: 'pt_BR', ru: 'ru_RU', de: 'de_DE', ja: 'ja_JP', it: 'it_IT', pl: 'pl_PL', uk: 'uk_UA',
};
const ogLocale = OG_LOCALE[lang] ?? 'en_US';
const ogLocaleAlternates = ALL_LOCALES.map((l) => OG_LOCALE[l]).filter((code) => code !== ogLocale);
const ogImage = new URL('/og-image.png', Astro.site).toString();
const ogImageAlt = 'Unfleece — free, private PDF tools that run entirely in your browser.';
const t = LAYOUT_TEXT[lang];
const categories = CATEGORY_TEXT[lang];
const dir = bundle(lang).meta.dir;
const currentPath = Astro.url.pathname;
const homeHref = localizedPath(lang, '/');
const toolsHref = `${homeHref === '/' ? '' : homeHref}#tools-section`;
// The About page is English-only for now (its body copy isn't translated), so
// link to it directly rather than a non-existent localized URL.
const aboutHref = '/about';
const langOptions = ALL_LOCALES.map((code) => ({
  code,
  autonym: LOCALES[code].autonym,
  htmlLang: LOCALES[code].htmlLang,
  optionDir: LOCALES[code].dir,
  href: switchLocalePath(currentPath, code),
  current: code === lang,
}));
---

<!doctype html>
<html lang={lang} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={new URL(alt.path, Astro.site).toString()} />)}
    <meta name="theme-color" content="#EEF1F7" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Unfleece" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Unfleece" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((code) => <meta property="og:locale:alternate" content={code} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Default theme is light; honor a saved 'dark' before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('uf-theme') === 'dark')
            document.documentElement.removeAttribute('data-theme');
        } catch (e) {}
      })();
    </script>

    <!-- Language suggestion (first visit only): system language → country.
         We never auto-redirect (Google advises against guessing the user's language);
         instead we surface a dismissible banner linking to the localized page. An
         explicit choice — the switcher, a banner click, or directly visiting a /<locale>/
         URL — is remembered forever and suppresses the suggestion. -->
    <script is:inline>
      (function () {
        var SUP = ['en', 'zh', 'hi', 'es', 'fr', 'ar', 'pt', 'ru', 'de', 'ja', 'it', 'pl', 'uk'];
        var KEY = 'uf-lang';
        var PHRASE = {
          es: 'Ver Unfleece en español', fr: 'Voir Unfleece en français', de: 'Unfleece auf Deutsch ansehen',
          it: 'Vedi Unfleece in italiano', pt: 'Ver o Unfleece em português', ru: 'Открыть Unfleece на русском',
          pl: 'Zobacz Unfleece po polsku', uk: 'Відкрити Unfleece українською', zh: '用中文查看 Unfleece', ja: 'Unfleece を日本語で見る',
          hi: 'Unfleece को हिंदी में देखें', ar: 'عرض Unfleece بالعربية',
        };
        try {
          if (localStorage.getItem(KEY)) return; // already chosen/dismissed — leave the user in control
          var path = location.pathname;
          var seg = path.split('/')[1];
          // A directly-visited localized URL (e.g. /uk/…) is an explicit choice: remember it, never nag.
          if (SUP.indexOf(seg) >= 0 && seg !== 'en') { localStorage.setItem(KEY, seg); return; }
          var toPath = function (loc) {
            return ((loc === 'en' ? '' : '/' + loc) + (path === '/' ? '' : path) || '/') + location.search + location.hash;
          };
          var suggest = function (pick) {
            if (!pick || pick === 'en' || !PHRASE[pick]) return;
            var dir = pick === 'ar' ? 'rtl' : 'ltr';
            var bar = document.createElement('div');
            bar.setAttribute('role', 'region');
            bar.setAttribute('aria-label', 'Language suggestion');
            bar.lang = pick; bar.dir = dir;
            bar.style.cssText = 'position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:60;display:flex;align-items:center;gap:.85rem;max-width:calc(100vw - 32px);padding:.7rem .8rem .7rem 1.1rem;background:var(--surface-glass-strong);backdrop-filter:blur(12px);border:1px solid var(--border-strong);border-radius:var(--radius-full);box-shadow:var(--shadow-lg);font-size:.95rem;color:var(--ink)';
            var a = document.createElement('a');
            a.href = toPath(pick); a.textContent = PHRASE[pick]; a.hreflang = pick;
            a.style.cssText = 'color:var(--ink);font-weight:600;text-decoration:none';
            a.addEventListener('click', function () { try { localStorage.setItem(KEY, pick); } catch (e) {} });
            var x = document.createElement('button');
            x.type = 'button'; x.textContent = '✕'; x.setAttribute('aria-label', 'Dismiss');
            x.style.cssText = 'flex:none;width:28px;height:28px;border:0;border-radius:var(--radius-full);background:var(--surface-sunken);color:var(--muted);font-size:.85rem;cursor:pointer;line-height:1';
            x.addEventListener('click', function () { try { localStorage.setItem(KEY, 'en'); } catch (e) {} bar.remove(); });
            bar.appendChild(a); bar.appendChild(x);
            (document.body || document.documentElement).appendChild(bar);
          };
          // 1) system languages (ordered by preference)
          var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
          for (var i = 0; i < prefs.length; i++) {
            var b = (prefs[i] || '').toLowerCase().split('-')[0];
            if (b === 'en') return; // English already preferred — no suggestion
            if (SUP.indexOf(b) >= 0) { suggest(b); return; }
          }
          // 2) country fallback (Cloudflare's free geo trace) — only when no system match
          fetch('/cdn-cgi/trace').then(function (r) { return r.text(); }).then(function (txt) {
            var m = /(?:^|\n)loc=([A-Z]{2})/.exec(txt);
            var COUNTRY = { CN:'zh',TW:'zh',HK:'zh',IN:'hi',ES:'es',MX:'es',AR:'es',CO:'es',CL:'es',PE:'es',FR:'fr',BE:'fr',
              EG:'ar',SA:'ar',AE:'ar',MA:'ar',DZ:'ar',IQ:'ar',JO:'ar',BR:'pt',PT:'pt',RU:'ru',BY:'ru',KZ:'ru',
              DE:'de',AT:'de',CH:'de',JP:'ja',IT:'it',PL:'pl',UA:'uk' };
            if (m && COUNTRY[m[1]]) suggest(COUNTRY[m[1]]);
          }).catch(function () {});
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={homeHref} aria-label={t.homeAria}>
          <img src="/logo.png" alt="" class="mark" width="30" height="30" />
          <span>unfleece</span>
        </a>

        <nav class="main-nav" aria-label={t.navAria}>
          <a href={toolsHref}>{t.allTools}</a>
          <a href={aboutHref}>{t.howItWorks}</a>
          <a href={`${aboutHref}#privacy`}>{t.privacy}</a>
        </nav>

        <div class="header-actions">
          <details class="lang-menu" id="lang-menu">
            <summary class="btn-icon lang-trigger" aria-label={t.language} title={t.language}>
              <Icon name="globe" />
              <span class="lang-current">{LOCALES[lang].autonym}</span>
              <span class="lang-caret" aria-hidden="true"><Icon name="chevronRight" /></span>
            </summary>
            <ul class="lang-list" role="menu" aria-label={t.language}>
              {langOptions.map((o) => (
                <li role="none">
                  <a
                    role="menuitem"
                    href={o.href}
                    hreflang={o.htmlLang}
                    lang={o.htmlLang}
                    dir={o.optionDir}
                    data-locale={o.code}
                    class={o.current ? 'lang-item current' : 'lang-item'}
                    aria-current={o.current ? 'true' : undefined}
                  >
                    <span class="lang-name">{o.autonym}</span>
                    {o.current && <span class="lang-tick"><Icon name="check" /></span>}
                  </a>
                </li>
              ))}
            </ul>
          </details>

          <button class="btn-icon theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme">
            <span class="moon"><Icon name="moon" /></span>
            <span class="sun"><Icon name="sun" /></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href={homeHref}><img src="/logo.png" alt="" class="mark" width="28" height="28" /><span>unfleece</span></a>
            <p>{t.footerBlurb}</p>
          </div>
          <div>
            <h4>{t.tools}</h4>
            <ul>
              <li><a href={toolsHref}>{categories.organize.label}</a></li>
              <li><a href={toolsHref}>{categories.convert.label}</a></li>
              <li><a href={toolsHref}>{categories.edit.label}</a></li>
              <li><a href={toolsHref}>{categories.optimize.label}</a></li>
              <li><a href={toolsHref}>{categories.forms.label}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t.project}</h4>
            <ul>
              <li><a href={aboutHref}>{t.howItWorks}</a></li>
              <li><a href={repo} target="_blank" rel="noopener">{t.github}</a></li>
              <li><a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener">{t.license}</a></li>
              <li><a href={`${repo}/issues`} target="_blank" rel="noopener">{t.reportIssue}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t.trust}</h4>
            <ul>
              <li class="footer-check"><Icon name="check" /> {t.noUpload}</li>
              <li class="footer-check"><Icon name="check" /> {t.noAccount}</li>
              <li class="footer-check"><Icon name="check" /> {t.noTracking}</li>
            </ul>
          </div>
        </div>
        <div class="footer-legal">
          <span>Open source · AGPL-3.0 · No file upload · No account · 🐑</span>
          <span>© 2026 Unfleece</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var KEY = 'uf-theme';
        var root = document.documentElement;
        function cur() { return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark'; }
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function label() { btn.setAttribute('aria-label', 'Switch to ' + (cur() === 'light' ? 'dark' : 'light') + ' theme'); }
        label();
        btn.addEventListener('click', function () {
          var next = cur() === 'light' ? 'dark' : 'light';
          if (next === 'light') root.setAttribute('data-theme', 'light');
          else root.removeAttribute('data-theme');
          try { localStorage.setItem(KEY, next); } catch (e) {}
          label();
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var menu = document.getElementById('lang-menu');
        if (!menu) return;
        // Remember an explicit choice so auto-detect never overrides it again.
        menu.querySelectorAll('a[data-locale]').forEach(function (a) {
          a.addEventListener('click', function () {
            try { localStorage.setItem('uf-lang', a.getAttribute('data-locale')); } catch (e) {}
          });
        });
        // Close the dropdown on outside click or Escape.
        document.addEventListener('click', function (e) {
          if (menu.open && !menu.contains(e.target)) menu.removeAttribute('open');
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menu.open) { menu.removeAttribute('open'); menu.querySelector('summary').focus(); }
        });
      })();
    </script>
    <script is:inline>
      (function () {
        if (!('serviceWorker' in navigator)) return;
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      })();
    </script>
  </body>
</html>
