---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist. Your files are fine — they never left your device anyway.">
  <section class="section">
    <div class="container content-width" style="text-align:center; padding: 4rem 0 5rem">
      <h1 class="h1">404 — nothing here</h1>
      <p class="desc" style="margin: 1rem auto 1.75rem; max-width: 46ch">
        That page doesn't exist. Your files are fine — they never left your device anyway.
      </p>
      <a class="btn btn-primary" href="/">Back to the tools</a>
    </div>
  </section>
</Base>
