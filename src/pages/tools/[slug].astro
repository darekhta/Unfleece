---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ToolRunner from '../../components/ToolRunner.svelte';
import SignTool from '../../components/SignTool.svelte';
import FillFormTool from '../../components/FillFormTool.svelte';
import RedactTool from '../../components/RedactTool.svelte';
import PageNumbersTool from '../../components/editor/PageNumbersTool.svelte';
import CropTool from '../../components/editor/CropTool.svelte';
import WatermarkTool from '../../components/editor/WatermarkTool.svelte';
import PromoNeoDeutsch from '../../components/PromoNeoDeutsch.astro';
import { TOOLS, CATEGORIES, type Tool } from '../../lib/registry';
import {
  CATEGORY_TEXT,
  bundle,
  LOCALES,
  RUNNER_TEXT,
  TOOL_PAGE_TEXT,
  localizeTool,
  localizedPath,
  localizedToolPath,
  toolAlternates,
  toolFaqs,
  toolIntro,
  type Locale,
} from '../../lib/locales';

export function getStaticPaths() {
  return TOOLS.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const locale: Locale = 'en';
const { tool: baseTool } = Astro.props as { tool: Tool };
const tool = localizeTool(baseTool, locale);
const cat = CATEGORIES[tool.category];
const catText = CATEGORY_TEXT[locale][tool.category];
const pageText = TOOL_PAGE_TEXT[locale];
const promo = bundle(locale).promo;

let related = TOOLS.filter((t) => t.category === baseTool.category && t.id !== baseTool.id);
if (related.length < 4) related = related.concat(TOOLS.filter((t) => t.category !== baseTool.category && t.id !== baseTool.id));
related = related.slice(0, 4).map((t) => localizeTool(t, locale));

const intro = toolIntro(baseTool, locale);
const faqs = toolFaqs(baseTool, locale) ?? pageText.faqs(tool.name);

// Absolute URLs for structured data (locale-correct).
const pageUrl = new URL(localizedToolPath(locale, baseTool.slug), Astro.site).toString();
const homeUrl = new URL(localizedPath(locale, '/'), Astro.site).toString();
const orgUrl = new URL('/', Astro.site).toString();
const breadcrumb = [
  { name: pageText.breadcrumbHome, item: homeUrl },
  { name: pageText.breadcrumbTools, item: `${homeUrl}#tools-section` },
  { name: catText.label, item: `${homeUrl}#cat-${tool.category}` },
  { name: tool.name, item: pageUrl },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: tool.name,
      description: tool.description,
      url: pageUrl,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any (web browser)',
      browserRequirements: 'Requires JavaScript and WebAssembly',
      inLanguage: LOCALES[locale].htmlLang,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@type': 'Organization', name: 'Unfleece', url: orgUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.item })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Base
  title={tool.name}
  description={tool.description}
  lang={locale}
  canonicalPath={localizedToolPath(locale, baseTool.slug)}
  alternates={toolAlternates(baseTool.slug)}
>
  <section class="section" style="padding-top:2.5rem">
    <div class="container content-width">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">{pageText.breadcrumbHome}</a><span class="sep"><Icon name="chevronRight" /></span>
        <a href="/#tools-section">{pageText.breadcrumbTools}</a><span class="sep"><Icon name="chevronRight" /></span>
        <a href={`/#cat-${tool.category}`}>{catText.label}</a><span class="sep"><Icon name="chevronRight" /></span>
        <span aria-current="page">{tool.name}</span>
      </nav>

      <header class="tool-header">
        <span class={cat.catClass ? `chip ${cat.catClass}` : 'chip'}><Icon name={tool.icon} /></span>
        <div>
          <h1 class="h1">{tool.name}</h1>
          <p class="desc">{tool.description}</p>
        </div>
      </header>

      <div class="runner" aria-label={`${tool.name} tool`}>
        <div class="runner-top">
          <div class="rt-id">
            <span class="rt-ico"><Icon name="shield" /></span>
            <span class="rt-label">{pageText.privateWorkspace}</span>
          </div>
          <span class="trust-pill rt-trust"><Icon name="lock" /> {pageText.nothingUploaded}</span>
        </div>
        <div class="runner-body-host">
          {
            tool.special === 'sign'
              ? <SignTool client:load tool={tool} />
              : tool.special === 'fill-form'
                ? <FillFormTool client:load tool={tool} />
                : tool.special === 'page-numbers'
                  ? <PageNumbersTool client:load tool={tool} />
                  : tool.special === 'crop'
                    ? <CropTool client:load tool={tool} />
                    : tool.special === 'watermark'
                      ? <WatermarkTool client:load tool={tool} />
                      : tool.special === 'redact'
                        ? <RedactTool client:load tool={tool} />
                        : <ToolRunner client:load tool={tool} t={RUNNER_TEXT[locale]} />
          }
        </div>
      </div>

      {/* Unique per-tool overview (English source; non-default locales render it once translated). */}
      {intro && (
        <section class="tool-section prose-width">
          <span class="eyebrow">Overview</span>
          <h2 class="h2">About {tool.name}</h2>
          <p class="body ink-soft">{intro}</p>
        </section>
      )}

      <!-- How it works -->
      <section class="tool-section">
        <span class="eyebrow">{pageText.howEyebrow}</span>
        <h2 class="h2">{pageText.howHeading(tool.name)}</h2>
        <div class="howto">
          {pageText.steps.map((step, index) => (
            <div class="step"><div class="n">{index + 1}</div><h4 class="h4">{step.title}</h4><p>{step.body}</p></div>
          ))}
        </div>
      </section>

      <!-- The honest difference -->
      <section class="tool-section">
        <span class="eyebrow">{pageText.differenceEyebrow}</span>
        <h2 class="h2">{pageText.differenceHeading}</h2>
        <div class="compare">
          <div class="col us">
            <h3 class="h4"><span class="chip" style="width:30px;height:30px"><Icon name="sheep" sw={1.6} /></span> Unfleece</h3>
            <ul>
              {pageText.usBullets.map((item) => <li><Icon name="check" /> {item}</li>)}
            </ul>
          </div>
          <div class="col them">
            <h3 class="h4">{pageText.themHeading}</h3>
            <ul>
              {pageText.themBullets.map((item) => <li><Icon name="x" /> {item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="tool-section prose-width">
        <span class="eyebrow">{pageText.questionsEyebrow}</span>
        <h2 class="h2">{pageText.questionsHeading}</h2>
        <div class="faq">
          {
            faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}<span class="chev"><Icon name="chevronRight" /></span></summary>
                <div class="answer">{f.a}</div>
              </details>
            ))
          }
        </div>
      </section>

      {promo && <PromoNeoDeutsch promo={promo} contained={false} />}

      <!-- Related -->
      <section class="tool-section">
        <span class="eyebrow">{pageText.relatedEyebrow}</span>
        <h2 class="h2">{pageText.relatedHeading}</h2>
        <div class="related-row">
          {
            related.map((t) => (
              <a class="related-card" href={localizedToolPath(locale, t.slug)}>
                <span class={CATEGORIES[t.category].catClass ? `chip ${CATEGORIES[t.category].catClass}` : 'chip'}>
                  <Icon name={t.icon} />
                </span>
                <span class="rc-name">{t.name}</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
