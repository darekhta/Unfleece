---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import HeroDrop from '../components/HeroDrop.svelte';
import { toolsByCategory } from '../lib/registry';

const groups = toolsByCategory();
---

<Base>
  <!-- Hero -->
  <section class="hero section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1 class="hero-display">
            Free, private PDF tools.<br />
            <span class="gradient-word">Your files never leave your browser.</span>
          </h1>
          <p class="subhead body-lg">
            Merge, split, convert, sign and compress — every tool runs entirely on your device.
            Free forever, no account, no upload. Open source, and honest about it.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary btn-lg" href="#tools-section">Browse tools <Icon name="arrowRight" sw={2} /></a>
            <a class="btn btn-ghost btn-lg" href="/about">How it works</a>
          </div>
        </div>

        <!-- Proof panel: a real quick-start — drop a file, pick a tool (file is handed over, never uploaded) -->
        <HeroDrop client:load />
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="section">
    <div class="container">
      <div class="trust-strip">
        <div class="trust-card glass">
          <span class="chip"><Icon name="shield" /></span>
          <h3 class="h4">Private by design</h3>
          <p class="body-sm">Files are processed locally and never uploaded. <a href="/about#privacy">Verify in your Network tab.</a></p>
        </div>
        <div class="trust-card glass">
          <span class="chip cat-forms"><Icon name="sparkle" /></span>
          <h3 class="h4">Free forever</h3>
          <p class="body-sm">No trials, no subscriptions, no file-size paywalls. There's nothing to upsell.</p>
        </div>
        <div class="trust-card glass">
          <span class="chip cat-convert"><Icon name="optimize" /></span>
          <h3 class="h4">Fast & open</h3>
          <p class="body-sm">Runs locally via WebAssembly. Fully open source (AGPL-3.0).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento tool grid -->
  <section class="section" id="tools-section" style="margin-top:4rem; scroll-margin-top:84px">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">All tools</span>
        <h2 class="h2">Pick a tool — it opens, you run it, you download.</h2>
        <p class="body">No sign-up. No queue. Everything happens in this tab.</p>
      </div>

      {
        groups.map((g) => (
          <section class="cat-band" id={`cat-${g.category}`} aria-labelledby={`h-${g.category}`}>
            <div class="cat-divider">
              <span class="eyebrow cat-eyebrow" id={`h-${g.category}`}>
                <span class="swatch" style={`background:${g.meta.hue}`} />
                {g.meta.label}
              </span>
              <span class="descriptor">{g.meta.descriptor}</span>
            </div>
            <div class="bento">
              {g.tools.map((t) => (
                <ToolCard tool={t} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <!-- Reassurance band -->
  <section class="section" id="how-section" style="margin-top:5rem; scroll-margin-top:84px">
    <div class="container">
      <div class="reassure glass">
        <div>
          <span class="eyebrow accent-text" style="display:block;margin-bottom:.75rem">Don't trust us — verify it</span>
          <h2 class="h2">It works in 10 seconds, and you can prove it's private.</h2>
          <p class="body">No file ever touches a server, so there's nothing to bill you for and nothing to leak. Free is just the honest default.</p>
        </div>
        <div class="steps">
          <div class="step"><span class="n">1</span><p><strong>Open any tool</strong> and press F12 → Network tab.</p></div>
          <div class="step"><span class="n">2</span><p><strong>Run it on a file.</strong> Watch the request list.</p></div>
          <div class="step"><span class="n">3</span><p><strong>See nothing upload.</strong> Turn off Wi-Fi — it still works.</p></div>
        </div>
      </div>
    </div>
  </section>
</Base>
